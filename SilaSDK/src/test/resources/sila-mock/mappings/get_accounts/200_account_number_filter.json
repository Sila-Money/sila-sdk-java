{
  "priority": 5,
  "request": {
    "method": "POST",
    "url": "/get_accounts",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.search_filters.account_number",
          "matches": "^[0-9]{5,17}$"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "get_accounts/200_account_number_filter.json",
    "transformers": [
      "response-template"
    ]
  }
}
