{
  "priority": 6,
  "request": {
    "method": "POST",
    "url": "/register",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.entity[?(@.type == 'business')]"
      },
      {
        "matchesJsonPath": {
          "expression": "$.entity.entity_name",
          "matches": "^(.{0,2}|.{201,})$"
        }
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "register/400_invalid_entity_name.json"
  }
}
