{
  "priority": 5,
  "request": {
    "method": "POST",
    "url": "/issue_sila",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.header[?(@.user_handle =~ /(?i)javasdk-user1-.*/)]"
      },
      {
        "matchesJsonPath": "$[?(@.amount == 1000 && @.account_name == 'default')]"
      },
      {
        "matchesJsonPath": {
          "expression": "$.business_uuid",
          "absent": true
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.descriptor",
          "absent": true
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.processing_type",
          "absent": true
        }
      }
    ]
  },
  "response": {
    "status": 401,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "issue_sila/401_invalid_user_signature.json"
  }
}
