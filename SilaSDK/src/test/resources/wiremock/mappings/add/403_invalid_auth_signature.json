{
  "priority": 0,
  "request": {
    "method": "POST",
    "urlPathPattern": "/add/.*",
    "customMatcher": {
      "name": "invalid-auth-signature"
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "add/403_invalid_auth_signature.json"
  }
}
