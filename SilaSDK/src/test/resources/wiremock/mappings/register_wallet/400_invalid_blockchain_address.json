{
  "priority": 5,
  "request": {
    "method": "POST",
    "url": "/register_wallet",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.wallet.blockchain_address",
          "doesNotMatch": "^0x[0-9a-fA-F]{40}$"
        }
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "register_wallet/400_invalid_blockchain_address.json"
  }
}
